# ==============================================================================
# CritHit — Matriz de Variables de Entorno de Producción
# ==============================================================================

# ==============================================================================
# 1. SERVICIO BACKEND (Railway / Render / Docker Container)
# ==============================================================================

# Entorno y Puerto
NODE_ENV=production
PORT=4000

# Base de Datos PostgreSQL en Supabase
# Se recomienda usar la URL del Transaction Pooler (puerto 6543) para alto volumen de peticiones
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require

# Conexión Directa para Migraciones de Prisma (puerto 5432)
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Seguridad & Autenticación JWT (Generar strings aleatorios de al menos 64 caracteres)
# Generar en terminal con: openssl rand -base64 48
JWT_SECRET=reemplazar_con_un_secreto_criptografico_seguro_de_al_menos_64_caracteres_123
JWT_REFRESH_SECRET=reemplazar_con_otro_secreto_criptografico_seguro_de_al_menos_64_caracteres_456

# Orígenes Permitidos por CORS (Separados por coma)
# Las URLs de Vercel (*.vercel.app) y dominios locales ya son admitidos automáticamente
CORS_ORIGINS=https://crithit.gg,https://crithit-web.vercel.app

# API Externa de Videojuegos (RAWG)
RAWG_API_KEY=tu_clave_de_rawg_api_aqui

# Autenticación Social con Google OAuth 2.0 (Opcional)
GOOGLE_CLIENT_ID=tu_cliente_id_de_google_oauth.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_cliente_secret_de_google_oauth
GOOGLE_CALLBACK_URL=https://api.crithit.gg/api/auth/google/callback

# Redis Cache (Opcional — si se habilita instancia en Railway o Upstash)
# REDIS_URL=rediss://default:password@host:port

# ==============================================================================
# 2. SERVICIO FRONTEND (Vercel)
# ==============================================================================

# URL Pública de la API Backend (apuntando a Railway o dominio propio)
NEXT_PUBLIC_API_URL=https://api.crithit.gg/api

# URL Pública del Sitio Web (para metadatos canónicos, OpenGraph y Twitter Cards)
NEXT_PUBLIC_SITE_URL=https://crithit.gg
